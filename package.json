{
  "name": "@acme/nest-integration",
  "version": "0.1.0",
  "description": "Módulo NestJS derivable (EIP / homónimo de Spring Integration): canales, flow DSL, activators, inbound/outbound adapters (REST/gRPC/Rabbit/GraphQL), trazas e idempotencia.",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.mjs",
      "require": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "bounds": "depcruise src test --config .dependency-cruiser.cjs",
    "verify": "npm run typecheck && npm run build && npm run test && npm run bounds"
  },
  "peerDependencies": {
    "@nestjs/common": "^10 || ^11",
    "@nestjs/core": "^10 || ^11",
    "@nestjs/swagger": "^7 || ^8",
    "reflect-metadata": ">=0.1.12",
    "rxjs": "^7.8"
  },
  "peerDependenciesMeta": {
    "amqplib": {
      "optional": true
    },
    "@grpc/grpc-js": {
      "optional": true
    },
    "@nestjs/graphql": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^10.4.1",
    "@nestjs/core": "^10.4.1",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/testing": "^10.4.22",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "dependency-cruiser": "^16.3.0",
    "jest": "^29.7.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "ts-jest": "^29.2.3",
    "tsup": "^8.2.0",
    "typescript": "^5.5.4"
  }
}
