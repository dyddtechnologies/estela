{
  "name": "@estela/nest",
  "version": "0.1.0",
  "description": "ESTELA — EIP runtime for NestJS (Spring Integration homolog): in-memory channels (direct/queue/pubsub/fanout), flow DSL, activators, inbound REST/gRPC/Rabbit/GraphQL, tracing, idempotency and a live topology graph.",
  "license": "MIT",
  "author": "Eliu Diaz (https://www.linkedin.com/in/eliudiaz)",
  "maintainers": [
    "eliudiaz-dydd"
  ],
  "homepage": "https://github.com/dyddtechnologies/estela#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dyddtechnologies/estela.git"
  },
  "bugs": {
    "url": "https://github.com/dyddtechnologies/estela/issues"
  },
  "keywords": [
    "nestjs",
    "eip",
    "enterprise-integration-patterns",
    "spring-integration",
    "messaging",
    "channels",
    "pubsub",
    "fanout",
    "request-reply",
    "idempotency",
    "tracing",
    "flow",
    "dsl",
    "mermaid"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.mjs",
      "require": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "bounds": "depcruise src test --config .dependency-cruiser.cjs",
    "verify": "npm run typecheck && npm run build && npm run test && npm run bounds"
  },
  "peerDependencies": {
    "@nestjs/common": "^10 || ^11",
    "@nestjs/core": "^10 || ^11",
    "@nestjs/swagger": "^7 || ^8",
    "reflect-metadata": ">=0.1.13",
    "rxjs": "^7"
  },
  "peerDependenciesMeta": {
    "amqplib": {
      "optional": true
    },
    "@grpc/grpc-js": {
      "optional": true
    },
    "@nestjs/graphql": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^10.4.1",
    "@nestjs/core": "^10.4.1",
    "@nestjs/platform-express": "^10.4.1",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/testing": "^10.4.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "dependency-cruiser": "^16.3.0",
    "jest": "^29.7.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "ts-jest": "^29.2.3",
    "tsup": "^8.2.0",
    "typescript": "^5.5.4"
  }
}
