{
  "name": "@estela/nest",
  "version": "0.1.0",
  "description": "ESTELA — EIP runtime for NestJS (Spring Integration homolog): in-memory channels (direct/queue/pubsub/fanout), flow DSL, activators, inbound REST/gRPC/Rabbit/GraphQL, tracing, idempotency and a live topology graph.",
  "license": "MIT",
  "author": "Eliu Diaz (https://www.linkedin.com/in/eliudiaz)",
  "maintainers": [
    "eliudiaz-dydd"
  ],
  "homepage": "https://github.com/dyddtechnologies/estela#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dyddtechnologies/estela.git"
  },
  "bugs": {
    "url": "https://github.com/dyddtechnologies/estela/issues"
  },
  "keywords": [
    "nestjs",
    "eip",
    "enterprise-integration-patterns",
    "spring-integration",
    "messaging",
    "channels",
    "pubsub",
    "fanout",
    "request-reply",
    "idempotency",
    "tracing",
    "flow",
    "dsl",
    "mermaid"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.mjs",
      "require": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "overrides": {
    "multer": "^2.2.1",
    "js-yaml": "^4.3.2",
    "lodash": "^4.18.1"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "format:check": "prettier --check .",
    "format:write": "prettier --write src test eslint.config.js",
    "complexity": "madge --extensions ts --circular src && jscpd src --min-tokens 60 --ignore '**/*.spec.ts' --reporters consoleSummary --threshold 1",
    "audit:ci": "npm audit --audit-level=high && npx lockfile-lint --path package-lock.json --allowed-hosts npm --validate-https --empty-hostname false",
    "test": "jest",
    "bounds": "depcruise src test --config .dependency-cruiser.cjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run build && npm run test && npm run bounds && npm run complexity && npm run audit:ci"
  },
  "peerDependencies": {
    "@nestjs/common": "^10 || ^11",
    "@nestjs/core": "^10 || ^11",
    "@nestjs/swagger": "^7 || ^8",
    "reflect-metadata": ">=0.1.13",
    "rxjs": "^7"
  },
  "peerDependenciesMeta": {
    "amqplib": {
      "optional": true
    },
    "@grpc/grpc-js": {
      "optional": true
    },
    "@nestjs/graphql": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^8.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "dependency-cruiser": "^16.3.0",
    "eslint": "^10.10.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.1",
    "jest": "^29.7.0",
    "jscpd": "^5.2.1",
    "lockfile-lint": "^5.0.1",
    "madge": "^8.0.0",
    "prettier": "^3.9.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ts-jest": "^29.2.3",
    "tsup": "^8.2.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.70.0"
  }
}
